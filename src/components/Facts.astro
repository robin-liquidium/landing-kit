---
interface Props {
  items: { value: string; label: string }[];
  /** A footnote, such as how the numbers were measured. */
  note?: string;
}
const { items, note } = Astro.props;
---

<dl class="rb-facts">
  {items.map((item) => (
    <div>
      <dt>{item.label}</dt>
      <dd>{item.value}</dd>
    </div>
  ))}
</dl>
{note && <p class="rb-footnote">{note}</p>}
