---
import DownloadIcon from './DownloadIcon.astro';

interface Props {
  /** The closing line, one entry per line. */
  lines: string[];
  href: string;
  label: string;
  /** Short facts under the button, such as version and requirements. */
  details?: string[];
}
const { lines, href, label, details = [] } = Astro.props;
---

<section class="rb-closing rb-shell">
  <h2 class="rb-closing-title">
    {lines.map((line) => (
      <span>
        {line}
        <br />
      </span>
    ))}
  </h2>
  <div class="rb-actions">
    <a class="rb-button" href={href}>
      <DownloadIcon />
      {label}
    </a>
  </div>
  {details.length > 0 && (
    <ul class="rb-notes">
      {details.map((detail) => (
        <li>{detail}</li>
      ))}
    </ul>
  )}
  <slot />
</section>
