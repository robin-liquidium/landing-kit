---
import { wallets } from '../projects';

interface Props {
  name: string;
}
const { name } = Astro.props;
---

<section class="rb-support" aria-labelledby="rb-support-title">
  <div>
    <h2 id="rb-support-title">Buy me a coffee</h2>
    <p>
      If {name} makes your day a little easier, you can support its continued
      development.
    </p>
  </div>
  <div class="rb-wallets">
    {wallets.map((wallet) => (
      <div class="rb-wallet">
        <span>{wallet.name}</span>
        <code title={wallet.address}>{wallet.address}</code>
        <button
          type="button"
          data-copy={wallet.address}
          aria-label={`Copy ${wallet.name} address`}
          title={`Copy ${wallet.name} address`}
        >
          <svg class="rb-copy" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="12" height="12" rx="2.5" />
            <path d="M5 15H4.5A1.5 1.5 0 0 1 3 13.5v-9A1.5 1.5 0 0 1 4.5 3h9A1.5 1.5 0 0 1 15 4.5V5" />
          </svg>
          <svg class="rb-check" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m5 12.5 4.5 4.5L19 7.5" />
          </svg>
        </button>
      </div>
    ))}
  </div>
  <p class="rb-visually-hidden" role="status" data-copy-status></p>
</section>

<script>
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-copy]',
  )) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    const name = button
      .closest('.rb-wallet')
      ?.querySelector('span')?.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        if (status) status.textContent = `Couldn’t copy the ${name} address.`;
        return;
      }
      if (status) status.textContent = `${name} address copied.`;
      button.dataset.copied = '';
      clearTimeout(timer);
      timer = setTimeout(() => delete button.dataset.copied, 1600);
    });
  }
</script>
