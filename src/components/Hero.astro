---
import DownloadIcon from './DownloadIcon.astro';
import { textWidth } from '../metrics';
import type { Link } from '../projects';

interface Props {
  /** The headline, one entry per line. */
  lines: string[];
  lede: string;
  cta: Link;
  /** A quieter second action. */
  link?: Link;
  /** Short facts under the actions, such as requirements. */
  notes?: string[];
  /** Size each line to fill the page width on wider screens. */
  fit?: boolean;
}
const { lines, lede, cta, link, notes = [], fit = false } = Astro.props;
// Long lines are set smaller, so they need looser tracking than short ones.
const tracking = (line: string) =>
  Math.round(
    Math.max(-0.045, Math.min(-0.012, -0.06 + line.length * 0.0014)) * 1000,
  ) / 1000;
---

<section class="rb-hero rb-shell">
  <h1 class:list={['rb-display', { 'rb-fit': fit }]}>
    {lines.map((line, index) => (
      <span
        class="rb-line"
        style={`--i: ${index}; --track: ${tracking(line)}em; --fit: ${textWidth(line, tracking(line))}`}
      >
        <span>{line}</span>
      </span>
    ))}
  </h1>
  <p class="rb-lede">{lede}</p>
  <div class="rb-actions">
    <a class="rb-button" href={cta.href}>
      <DownloadIcon />
      {cta.label}
    </a>
    {link && (
      <a class="rb-quiet" href={link.href}>
        {link.label}
      </a>
    )}
  </div>
  {notes.length > 0 && (
    <ul class="rb-notes">
      {notes.map((note) => (
        <li>{note}</li>
      ))}
    </ul>
  )}
  <slot />
</section>
