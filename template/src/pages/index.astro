---
import Closing from '@robin-build/landing-kit/components/Closing.astro';
import Facts from '@robin-build/landing-kit/components/Facts.astro';
import Faq from '@robin-build/landing-kit/components/Faq.astro';
import FeatureList from '@robin-build/landing-kit/components/FeatureList.astro';
import Hero from '@robin-build/landing-kit/components/Hero.astro';
import Section from '@robin-build/landing-kit/components/Section.astro';
import Site from '../layouts/Site.astro';
---

<Site>
  <main id="main">
    <Hero
      lines={['Big promise.', 'Small app.']}
      lede="One or two plain sentences about what it does for you."
      cta={{ label: 'Download for Mac', href: '/download' }}
      link={{ label: 'How it works', href: '#how' }}
      notes={['Free and open source', 'macOS 15 or later']}
    />

    <Section title="Numbers worth knowing." layout="stack">
      <Facts
        items={[
          { value: '1', label: 'Something worth counting' },
          { value: '0', label: 'Accounts or analytics' },
        ]}
      />
    </Section>

    <Section
      id="how"
      title="What it does."
      intro="A sentence that expands on it."
    >
      <FeatureList
        items={[
          { title: 'First thing', text: 'Why it matters.' },
          { title: 'Second thing', text: 'Why it matters.' },
        ]}
      />
    </Section>

    <Section title="Questions.">
      <Faq items={[{ q: 'Is it free?', a: 'Yes, and open source.' }]} />
    </Section>

    <Closing
      lines={['Closing line', 'that lands.']}
      href="/download"
      label="Download Example"
      details={['Version 1.0', 'macOS 15 or later']}
    />
  </main>
</Site>
