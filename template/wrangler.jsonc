{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "example-website",
  "compatibility_date": "2026-11-05",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "example.robin.build", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
}
